node_modules
.next
out
# Bundled offline fallback served by Capacitor when the remote app
# can't be reached on cold-start. Lives under out/ so the native
# Android/iOS sync picks it up; not regenerated by `next build`,
# kept in source control here.
!out/offline.html
.env
.env.local

# PWA generated files
public/sw.js
public/workbox-*.js
public/sw.js.map
public/workbox-*.js.map

# Phase 3 migration: prod DB dump used for staging restore — never commit
prod_snapshot.dump
*.dump

# Android signing keys — NEVER commit. Audited 2026-04-28: never been
# in git history. Specific path + glob defense-in-depth.
android/app/hai-release.keystore
*.keystore
*.jks

# Store-listing screenshots — regeneratable outputs of the styling
# scripts under scripts/. Living in public/ would also serve them at
# https://app.hai-app.net/screenshots/... which we don't want.
# Sources of truth: the raw/* originals and the *.mjs scripts.
public/screenshots/
public/screenshots-raw/
public/screenshots-ipad-raw/
public/screenshots-store/
public/screenshots-store-android/
public/screenshots-store-iphone/
public/screenshots-store-ipad/
