node_modules
.next
out
# Bundled offline fallback served by Capacitor when the remote app
# can't be reached on cold-start. Lives under out/ so the native
# Android/iOS sync picks it up; not regenerated by `next build`,
# kept in source control here.
!out/offline.html
.env
.env.local

# PWA generated files
public/sw.js
public/workbox-*.js
public/sw.js.map
public/workbox-*.js.map

# Phase 3 migration: prod DB dump used for staging restore — never commit
prod_snapshot.dump
*.dump

# Android signing keys — NEVER commit. Audited 2026-04-28: never been
# in git history. Specific path + glob defense-in-depth.
android/app/hai-release.keystore
*.keystore
# Android signing credentials — loaded by android/app/build.gradle on
# local builds. CI uses HAI_KEYSTORE_PASSWORD / HAI_KEY_PASSWORD env
# vars instead; never commit this file.
android/keystore.properties
*.jks

# Store-listing screenshots — regeneratable outputs of the styling
# scripts under scripts/. Living in public/ would also serve them at
# https://app.hai-app.net/screenshots/... which we don't want.
# Sources of truth: the raw/* originals and the *.mjs scripts.
public/screenshots/
public/screenshots-raw/
public/screenshots-ipad-raw/
public/screenshots-store/
public/screenshots-store-android/
public/screenshots-store-iphone/
public/screenshots-store-ipad/

# Local-only / generated files — were tracked historically by mistake;
# untracked via `git rm --cached` in the same commit that added them
# here. Local copies preserved.

# Per-machine Claude Code permissions / overrides.
.claude/settings.local.json

# Auto-generated by `npx cap sync` from capacitor.config.ts and the
# installed @capacitor/* packages. Always rewritten on sync, so any
# committed version goes stale within a release cycle.
android/app/capacitor.build.gradle
android/capacitor.settings.gradle

# TypeScript incremental build cache. Rewritten by `tsc` / `next build`
# on every run; no value in source control.
tsconfig.tsbuildinfo

.vercel
.env*.local
stickers-preview.html
membership-preview.html

_extract_numbers.cjs
_service_numbers.csv
_extracted.json
