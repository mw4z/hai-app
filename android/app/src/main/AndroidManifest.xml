<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: open https://app.hai-app.net/{s,i,threads,directory}/*
                 directly in the app (verified via /.well-known/assetlinks.json). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.hai-app.net" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="app.hai-app.net" android:pathPrefix="/i/" />
                <data android:scheme="https" android:host="app.hai-app.net" android:pathPrefix="/threads/" />
                <data android:scheme="https" android:host="app.hai-app.net" android:pathPrefix="/directory/" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ACCESS_NETWORK_STATE: needed for the cold-start offline-page
         auto-recovery in MainActivity (registerNetworkCallback). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Voice notes in chat (@capgo/capacitor-audio-recorder). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- WRITE_CONTACTS is required by @capacitor-community/contacts'
         permission alias "contacts", which groups BOTH read and write.
         Capacitor's Plugin.getPermissionState() returns GRANTED only if
         all permissions in the alias are granted; without WRITE_CONTACTS
         declared here, ContextCompat.checkSelfPermission() returns
         DENIED for it at the OS level (you can't grant a permission
         not declared), so the alias is forever DENIED — the plugin
         never opens the picker no matter what the user toggles in
         Settings. We don't actually use write APIs from the plugin,
         but declaring this is the only way to make the read picker work. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Android 11+ package visibility. Without these <queries>
         declarations, Intent.resolveActivity() returns null for the
         contact picker / image picker / share sheet on devices targeting
         SDK 30+, even when the system app exists — so the @capacitor-
         community/contacts plugin's pickContact() silently failed and
         the chat composer fell through to the manual name+phone prompt
         instead of opening the OS Contacts UI. -->
    <queries>
        <!-- Contact picker (ACTION_PICK on contacts content URI) -->
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="vnd.android.cursor.dir/contact" />
        </intent>
        <!-- Generic image picker / file chooser -->
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="image/*" />
        </intent>
        <!-- Camera capture (used for photo attachments) -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Share sheet (used by post share button + system share) -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- External browser launch (Browser.open used by social links) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
