<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">#0f172a</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Transparent bars in dark mode too — the WebView paints
             its own #000 background edge-to-edge, so no mismatched
             strip shows up next to the system bars. -->
        <item name="android:statusBarColor">@color/hai_surface</item>
        <item name="android:navigationBarColor">@color/hai_surface</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/hai_surface</item>
        <item name="android:navigationBarColor">@color/hai_surface</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Dark variant. Same change as values/styles.xml: switched
             windowSplashScreenAnimatedIcon from a 1x1 transparent
             placeholder (paired with the now-deleted JS AppSplash) to
             the real brand mark, so the system-controlled splash on
             Android 12+ actually shows the icon. -->
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_bg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
