<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark brand palette: matches .dark hai-primary / hai-bg
         tokens in src/app/design-tokens.css. splash_bg is true-black
         so the native splash seams into the webview's #000000 page. -->
    <color name="colorPrimary">#00a884</color>
    <color name="colorPrimaryDark">#000000</color>
    <color name="colorAccent">#00a884</color>
    <!-- App dark-mode page bg (matches --hai-bg in design-tokens.css)
         so the native splash seams into the WebView's #19232a page
         color instead of pure black. -->
    <color name="splash_bg">#19232a</color>
    <!-- Dark surface for system bars (pre-API 29 scrim avoidance). -->
    <color name="hai_surface">#101619</color>
</resources>
