<?xml version="1.0" encoding="utf-8"?>
<!--
    Capacitor SplashScreen plugin drawable.

    Now references splash_composite.png (rendered offline by
    scripts/regen-ios-splash.js) which contains the FULL composition:
    background fill + smaller brand icon + "حَيّ" Arabic + "HAI"
    subordinate text below. Light variant lives in this drawable/
    folder; dark variant lives in drawable-night/splash_composite.png.

    Android automatically picks the right one based on the system's
    Night Mode. Capacitor's ImageView renders the bitmap with
    CENTER_CROP, so the centered icon+text composition stays
    visually centered on the screen regardless of device aspect.

    The previous layer-list referencing @drawable/ic_launcher_splash
    (icon-only vector) is no longer needed for this overlay — the
    ic_launcher_splash drawable is still kept for the Android 12+
    SYSTEM splash (windowSplashScreenAnimatedIcon), which is
    constrained to a 108dp circle and can't show text.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/splash_composite"
    android:gravity="center" />
