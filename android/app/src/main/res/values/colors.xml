<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand palette: unified WhatsApp-teal family (matches the
         hai-primary tokens in src/app/design-tokens.css). -->
    <color name="colorPrimary">#00a884</color>
    <color name="colorPrimaryDark">#006d57</color>
    <color name="colorAccent">#00a884</color>
    <color name="splash_bg">#e0f7f2</color>
    <!-- Surface colors for system bars. Pre-API 29 Android applies a
         gray contrast scrim to translucent bars; setting an opaque
         brand-matching color avoids the scrim. Matches the JS-side
         StatusBar.setBackgroundColor in CapacitorBridge. -->
    <color name="hai_surface">#ffffff</color>
</resources>
