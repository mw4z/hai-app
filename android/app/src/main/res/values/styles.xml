<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">#ffffff</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Transparent system bars so the WebView draws edge-to-edge.
             Opaque white bars caused some Android OEM skins (Samsung,
             OnePlus) to render a gray strip where the status or
             navigation bar sat on top of the app content. -->
        <item name="android:statusBarColor">@color/hai_surface</item>
        <item name="android:navigationBarColor">@color/hai_surface</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Transparent system bars — the WebView draws behind them,
             and Capacitor's StatusBar plugin (setOverlaysWebView:true
             in CapacitorBridge) paints the right icon contrast on top.
             enforceContrast=false stops Android 10+ from auto-applying
             its own scrim under the bars. -->
        <item name="android:statusBarColor">@color/hai_surface</item>
        <item name="android:navigationBarColor">@color/hai_surface</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Plain coloured launch theme — NOT Theme.SplashScreen.
             The Android 12+ system splash API forces a centred app
             icon on top of the background, which read as an "intro
             screen" before the real JS splash. iOS does not do
             this — its LaunchScreen.storyboard just shows a solid
             colour matching the JS splash bg and hands off cleanly.
             We mirror that on Android: window background is the
             splash colour (#e0f7f2 light / #000 dark via
             values-night), no icon, no animated splash. The Capacitor
             native splash is already disabled (launchShowDuration: 0
             in capacitor.config.ts) so the user goes straight from
             this coloured frame into AppSplash. -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
