<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">#ffffff</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Transparent system bars so the WebView draws edge-to-edge.
             Opaque white bars caused some Android OEM skins (Samsung,
             OnePlus) to render a gray strip where the status or
             navigation bar sat on top of the app content. -->
        <item name="android:statusBarColor">@color/hai_surface</item>
        <item name="android:navigationBarColor">@color/hai_surface</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Transparent system bars — the WebView draws behind them,
             and Capacitor's StatusBar plugin (setOverlaysWebView:true
             in CapacitorBridge) paints the right icon contrast on top.
             enforceContrast=false stops Android 10+ from auto-applying
             its own scrim under the bars. -->
        <item name="android:statusBarColor">@color/hai_surface</item>
        <item name="android:navigationBarColor">@color/hai_surface</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Android 12+ system splash. With JS AppSplash removed, this
             is now the ONLY layer that shows the brand mark on the
             system-controlled portion of the launch (before Capacitor's
             ImageView splash takes over). Previously the icon was a
             1x1 transparent placeholder — that worked when AppSplash
             showed the icon a few frames later, but with no AppSplash
             the user saw a blank green screen with no brand at all.
             Now points at ic_launcher_splash so the system splash IS
             the branded splash. -->
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_bg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
