<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">#ffffff</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Transparent system bars so the WebView draws edge-to-edge.
             Opaque white bars caused some Android OEM skins (Samsung,
             OnePlus) to render a gray strip where the status or
             navigation bar sat on top of the app content. -->
        <item name="android:statusBarColor">@color/hai_surface</item>
        <item name="android:navigationBarColor">@color/hai_surface</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Transparent system bars — the WebView draws behind them,
             and Capacitor's StatusBar plugin (setOverlaysWebView:true
             in CapacitorBridge) paints the right icon contrast on top.
             enforceContrast=false stops Android 10+ from auto-applying
             its own scrim under the bars. -->
        <item name="android:statusBarColor">@color/hai_surface</item>
        <item name="android:navigationBarColor">@color/hai_surface</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Android 12+ uses the SplashScreen API regardless of what
             parent theme we pick. The previous attempt to dodge it by
             extending Theme.AppCompat.DayNight.NoActionBar still got
             the system-default centered launcher icon on newer phones
             — what the user reported as "large app icon intro before
             the splash".
             Now we OPT IN to Theme.SplashScreen and:
               * paint the splash_bg the JS AppSplash also uses, so
                 the handoff is seamless;
               * supply a 1x1 transparent drawable as the animated
                 icon — Android requires a drawable, but transparent
                 means nothing visible;
               * postSplashScreenTheme = AppTheme.NoActionBar so once
                 the system splash dismisses we land directly on the
                 normal app theme without a flash. -->
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_bg</item>
        <item name="windowSplashScreenAnimationDuration">100</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
