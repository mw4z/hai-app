{
  "name": "hai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "patch-package && prisma generate",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test:policy": "cross-env TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"esModuleInterop\":true,\"jsx\":\"react\",\"target\":\"ES2020\",\"skipLibCheck\":true}' node --require ts-node/register --test src/lib/display-policy.test.ts",
    "lint:state-badges": "node scripts/lint-state-badges.mjs"
  },
  "dependencies": {
    "@capacitor-community/contacts": "^7.1.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.1.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/keyboard": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^2.4.3",
    "hai-contacts": "file:plugins/hai-contacts",
    "jose": "^5.6.3",
    "maplibre-gl": "^5.21.1",
    "next": "14.2.4",
    "next-pwa": "^5.6.0",
    "nodemailer": "^8.0.4",
    "pg": "^8.20.0",
    "react": "^18",
    "react-dom": "^18",
    "react-easy-crop": "^5.5.7",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.2.1"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "opentype.js": "^1.3.4",
    "patch-package": "^8.0.1",
    "postcss": "^8",
    "prisma": "^7.5.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
