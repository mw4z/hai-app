generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Cities & Neighborhoods ───────────────────────────────────────────────────

model City {
  id            String         @id @default(cuid())
  name          String         // "مكة المكرمة"
  nameEn        String         // "Mecca"
  neighborhoods Neighborhood[]
  createdAt     DateTime       @default(now())
}

model Neighborhood {
  id        String   @id @default(cuid())
  name      String   // display name (Arabic)
  nameEn    String   // display name (English)
  lat       Float?   // center point (derived from polygon centroid)
  lng       Float?
  boundary  Json     // polygon [[lng,lat],...] — required, no longer optional
  bbox      Json     // [minLng, minLat, maxLng, maxLat] — required
  source    String   @default("balady") // "balady" | "community"
  baladyId  String?  // Balady DISTRICT_ID (null for community neighborhoods)
  hidden    Boolean  @default(false)   // hide non-residential (industrial, gov, plots)
  city      City     @relation(fields: [cityId], references: [id])
  cityId    String
  users     User[]
  posts     Post[]
  compounds Compound[]
  emergencyAlerts        EmergencyAlert[]
  emergencyAlertRequests EmergencyAlertRequest[]
  pollRequests           PollRequest[]
  placeListings          PlaceListing[]
  serviceContacts        DirectoryServiceContact[]
  directoryContributions DirectoryContribution[]
  pinnedItems            NeighborhoodPinnedItem[]
  neighborhoodClaims     NeighborhoodClaim[] @relation("neighborhoodClaims")
  createdAt DateTime @default(now())
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id               String        @id @default(cuid())
  phone            String        @unique  // Saudi format: 05xxxxxxxx
  lastSeenAt       DateTime?     // updated on every API request
  showLastSeen     Boolean       @default(true)  // privacy: show online/last seen
  showReadReceipts Boolean       @default(true)  // privacy: send read receipts
  showGender       Boolean       @default(true)  // privacy: show gender in profile popup
  // UI language preference, mirrored from the client so push payloads
  // (especially OS cleanup-banner copy) can be localized per recipient.
  // Updated via PATCH /api/profile/language on language toggle.
  language         String        @default("ar") // "ar" | "en" | "ur"
  isSeed           Boolean       @default(false) // generated seed user — admin-controlled
  name             String?       // first name
  lastName         String?       // last name / family name
  avatarUrl        String?
  coverUrl         String?
  email              String?
  emailVerified      Boolean  @default(false)
  emailVerifyToken   String?
  emailVerifyExpiry  DateTime?
  gender           Gender        @default(MALE)
  isVerified       Boolean       @default(false)  // phone OTP verified
  addressVerified  Boolean       @default(false)  // address/neighborhood verified
  addressProofUrl  String?       // uploaded lease/utility bill photo
  // ── Neighborhood membership (see Membership enum). `addressVerified`
  //    is kept mirrored: VERIFIED_RESIDENT ⟺ addressVerified=true, so all
  //    legacy reads keep working while membership is the richer source.
  membership              Membership @default(OUTSIDE)
  homeClaimedAt           DateTime?  // when CLAIMED_RESIDENT was set (manual claim)
  homeChangeCooldownUntil DateTime?  // can't change claimed home before this
  neighborhoodClaims      NeighborhoodClaim[] @relation("claimant")
  reviewedClaims          NeighborhoodClaim[] @relation("claimReviewer")
  reputation       Int           @default(0)
  accountType      AccountType   @default(NORMAL)
  providerStatus           ProviderStatus @default(NONE)  // visibility gate for provider listings (separate from accountType)
  providerStatusChangedAt  DateTime?      // last time providerStatus transitioned between NONE/PENDING/ACTIVE/VERIFIED — used to enforce 24h cooldown on apply/cancel
  role             UserRole      @default(RESIDENT)
  status           UserStatus    @default(ACTIVE)
  neighborhood     Neighborhood? @relation(fields: [neighborhoodId], references: [id])
  neighborhoodId   String?
  posts            Post[]
  postViews        PostView[]
  reports          Report[]      @relation("reporter")
  reportedPosts    Report[]      @relation("reportedUser")
  userReportsSent     UserReport[] @relation("userReporter")
  userReportsReceived UserReport[] @relation("userReported")
  otpCodes         OtpCode[]
  reactions        Reaction[]
  bookmarks        Bookmark[]
  postSubscriptions PostSubscription[]
  comments         Comment[]
  notifications    Notification[]
  notificationPreferences NotificationPreference[]
  threads1         Thread[]      @relation("threadUser1")
  threads2         Thread[]      @relation("threadUser2")
  messages         Message[]
  rideRequests     RideRequest[] @relation("rideRequests")
  rideOffers       RideOffer[]   @relation("rideOffers")
  supportTickets   SupportTicket[]
  polls            Poll[]
  driverRatingAvg    Float?
  driverRatingCount  Int           @default(0)
  driverTripsCount   Int           @default(0)
  driverCancelCount  Int           @default(0)
  plan             String        @default("FREE") // FREE | PREMIUM (internal only, never shown to users)
  bio              String?       // free-text "about me" (max 300 chars)
  modApprovedAt    DateTime?     // when user was promoted to mod (for probation tracking)
  // ── Moderator lifecycle (only meaningful when role=NEIGHBORHOOD_MOD) ──
  // modStatus drives both the mod's own powers (SUSPENDED = role intact
  // but cannot perform mod actions) and the admin-side review queue
  // (UNDER_REVIEW = pending human decision after inactivity or abuse
  // threshold). Resets to ACTIVE on promotion.
  modStatus         ModStatus     @default(ACTIVE)
  lastModActionAt   DateTime?     // last time the mod took any privileged action
  modActionsCount   Int           @default(0)  // lifetime counter, cheap "are they doing anything" signal
  modReportCount    Int           @default(0)  // pending (non-dismissed) reports filed against them as a mod
  modActionLogs     ModActionLog[] @relation("modActionLogs")
  serviceDescription String?     // service providers: what they offer
  serviceLat       Float?        // service location (optional)
  serviceLng       Float?
  serviceAddress   String?       // human-readable service address
  // Social links for service providers — keyed object:
  //   { instagram: "handle", tiktok: "handle", x: "handle",
  //     snapchat: "handle", whatsapp: "05xxxxxxxx" }
  // Only persisted for providerStatus ACTIVE | VERIFIED. See
  // lib/socialLinks.ts for the validator + deep-link builder used by
  // both the editor and the viewer. null/missing is equivalent to "no
  // links set".
  socialLinks      Json?
  notifyComments   Boolean       @default(true)
  notifyReactions  Boolean       @default(true)
  notifyReplies    Boolean       @default(true)
  notifyLookingFor Boolean       @default(true)
  notifyMessages   Boolean       @default(true)
  notifyRides      Boolean       @default(true)
  notifySystem     Boolean       @default(true)
  // ── Notification preset + quiet hours (Phase 1 of the redesign).
  // notificationPreset = the user's chosen preset (or MANUAL when they
  // edit a category directly). Per-category rows in NotificationPreference
  // remain the source of truth that canSendNotification reads.
  notificationPreset NotificationPreset @default(BALANCED)
  quietHoursEnabled  Boolean            @default(true)
  quietHoursStart    Int                @default(1320) // 22:00 in minutes from local midnight
  quietHoursEnd      Int                @default(420)  // 07:00
  timezone           String             @default("Asia/Riyadh")
  serviceItems     ServiceItem[]

  // ── Push notifications (FCM) ──
  deviceTokens     DeviceToken[]
  notifPreference  NotifPreference?

  // ── Emergency alerts ──
  emergencyAlerts        EmergencyAlert[]          @relation("emergencyAuthor")
  emergencyAlertsRevoked EmergencyAlert[]          @relation("emergencyRevoker")
  emergencyDismissals    EmergencyAlertDismissal[]
  // ── Emergency alert requests (user submissions pending mod review) ──
  emergencyRequestsGiven    EmergencyAlertRequest[] @relation("emergencyRequestRequester")
  emergencyRequestsReviewed EmergencyAlertRequest[] @relation("emergencyRequestReviewer")

  // ── Invite / density engine ──
  invitedById       String?
  invitesQualified  Int              @default(0)
  inviteBadgeTier   Int              @default(0)
  signupDeviceId    String?
  signupIpHash      String?
  inviteCode        InviteCode?
  invitesGiven      InviteRedemption[] @relation("invitesGiven")
  inviteReceived    InviteRedemption?  @relation("invitesReceived")
  fraudSignals      InviteFraudSignal[]

  // ── Weekly digest log back-relation ──
  digestLogs        DigestLog[]

  // ── Resident-submitted poll requests (Phase 1 of opening polls
  // ── beyond admin-only creation). Residents propose; mods review.
  // ── Direct Poll creation stays restricted to admin roles.
  submittedPollRequests PollRequest[] @relation("PollRequestSubmitter")
  reviewedPollRequests  PollRequest[] @relation("PollRequestReviewer")

  // ── Neighborhood Directory (دليل الحي) ─────────────────────────
  // Place submissions are gated by DIRECTORY_ENABLED (server) and
  // entry points by NEXT_PUBLIC_DIRECTORY_ENABLED (UI). createdByUser
  // is intentionally NEVER exposed in public API responses — see
  // src/lib/places/ for the privacy model.
  placesCreated         PlaceListing[]      @relation("PlacesCreated")
  placesClaimed         PlaceListing[]      @relation("PlacesClaimed")
  placesVerified        PlaceListing[]      @relation("PlacesVerified")
  placeClaimsSubmitted  PlaceClaimRequest[] @relation("PlaceClaimsSubmitted")
  placeClaimsReviewed   PlaceClaimRequest[] @relation("PlaceClaimsReviewed")
  placeReportsFiled     PlaceReport[]       @relation("PlaceReportsFiled")
  placeReportsReviewed  PlaceReport[]       @relation("PlaceReportsReviewed")
  placeReviewsAuthored  PlaceReview[]       @relation("PlaceReviewsAuthored")
  placeReviewsReplied   PlaceReview[]       @relation("PlaceReviewsReplied")
  serviceContactsCreated     DirectoryServiceContact[] @relation("ServiceContactsCreated")
  serviceIdentitiesLinked    ServiceIdentity[]         @relation("ServiceIdentityLinked")
  serviceIdentitiesOwned     ServiceIdentity[]         @relation("ServiceIdentityOwner")
  serviceContactReportsFiled ServiceContactReport[]    @relation("ServiceContactReportsFiled")
  placeReviewReportsFiled    PlaceReviewReport[] @relation("PlaceReviewReporter")
  directoryContributions         DirectoryContribution[] @relation("DirectoryContributions")
  directoryContributionsReviewed DirectoryContribution[] @relation("DirectoryContributionsReviewed")
  reputationEvents               ReputationEvent[]       @relation("ReputationEvents")
  pinnedItemsPinned     NeighborhoodPinnedItem[]         @relation("PinnedItemsPinned")
  pinnedItemsHidden     NeighborhoodPinnedItem[]         @relation("PinnedItemsHidden")
  pinnedItemAuditActions NeighborhoodPinnedItemAuditLog[] @relation("PinnedItemAuditActor")
  placeReviewReportsResolved PlaceReviewReport[] @relation("PlaceReviewReportResolver")

  deletedAt        DateTime?     // soft delete — null = active, set = deleted
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model ServiceItem {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  title         String                // e.g. "كبسة دجاج"
  description   String?               // optional details
  price         Int?                  // in SAR, null = "اتصل للسعر"
  imageUrl      String?               // product/service photo
  sortOrder     Int      @default(0)  // display order
  active        Boolean  @default(true)
  // Per-item visibility flags. Default both true so a fresh
  // catalog item appears everywhere the owner is surfaced —
  // public profile AND any directory place they've claimed.
  // The catalog editor (CatalogClient) lets the owner flip
  // these per item or via bulk actions. The owner sees ALL
  // their items regardless of these flags; the flags only
  // gate the PUBLIC surfaces.
  showOnProfile Boolean  @default(true)
  showOnPlace   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, active, sortOrder])
}

// ─── Usage Tracking (per user, per feature, per time window) ────────────────

model UsageCounter {
  id        String   @id @default(cuid())
  userId    String
  feature   String   // e.g. "posts", "rideOffers", "threads", "uploads", "catalogItems"
  count     Int      @default(0)
  windowStart DateTime // start of the counting window (midnight for daily)

  @@unique([userId, feature, windowStart])
  @@index([userId, feature])
}

// ─── Plan Change Audit Log ──────────────────────────────────────────────────

model PlanChangeLog {
  id           String   @id @default(cuid())
  userId       String
  previousPlan String
  newPlan      String
  changedBy    String   // admin userId or "SYSTEM"
  reason       String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── User Blocks (peer-to-peer, App Store compliance) ───────────────────────

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

enum AccountType {
  NORMAL
  SERVICE_PROVIDER
  VERIFIED_PROVIDER
}

enum ProviderStatus {
  NONE      // not a provider
  PENDING   // applied but quality gate not yet met
  ACTIVE    // meets the quality gate — visible in public provider listings
  VERIFIED  // admin-verified provider
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum UserRole {
  RESIDENT
  NEIGHBORHOOD_MOD
  COMPOUND_ADMIN
  PLATFORM_MOD
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  WARNED
  BANNED_TEMP
  BANNED_PERM
  PENDING_REVIEW
}

// Phase-1 notification preset model. Replaces "manage 9 toggles" with
// a 4-card preset picker. MANUAL is the escape hatch — selecting any
// individual category toggle demotes the user to MANUAL atomically
// (enforced at the API layer in /api/notifications/preferences).
enum NotificationPreset {
  URGENT_ONLY
  BALANCED
  EVERYTHING
  MANUAL
}

// ─── OTP ──────────────────────────────────────────────────────────────────────

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  verified  Boolean  @default(false)
  expiresAt DateTime
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  createdAt DateTime @default(now())

  @@index([phone])
}

// ─── Posts ────────────────────────────────────────────────────────────────────

model Post {
  id             String        @id @default(cuid())
  title          String
  body           String
  // Canonical category (post-Phase-4 rename of newCategory → category;
  // the old legacy `category PostCategory` was dropped in the same
  // migration). Required, no nullable fallback — every row has a v2
  // value after Phase 2 backfill.
  category       PostCategory
  intent         PostIntent       @default(NORMAL)
  priority       PostPriority     @default(NORMAL)
  audience       PostAudience     @default(ALL)
  // Whether the author was a resident of this post's neighborhood at
  // creation. OUTSIDE_REQUEST posts are request-only, badge "من خارج
  // الحي", and never boosted/pushed. Defaults RESIDENT for all existing
  // rows + every normal in-neighborhood post.
  originScope    PostOriginScope  @default(RESIDENT)
  // Subtype for category=MARKETPLACE only. Ignored otherwise. SELL is
  // the default so every existing Marketplace row keeps its meaning.
  marketplaceType MarketplaceType @default(SELL)
  // Phase 1 structured-metadata subtypes — all nullable, additive only.
  // Server-side classifier fills them when confidenceScore >= 0.85;
  // composer never asks for them. UI chips gated by
  // NEXT_PUBLIC_STRUCTURED_POST_METADATA. Cross-category writes are
  // dropped server-side (realEstateType only with REAL_ESTATE, etc.).
  realEstateType RealEstateType?
  civicType      CivicType?
  eventStartAt   DateTime?
  eventEndAt     DateTime?
  eventLocation  String?
  // Mod / admin manual category override audit. Null until a privileged
  // user has used PATCH /api/posts/:id/category. Surfaces a small
  // "edited by mod" signal in the PostCard for transparency.
  categoryEditedById String?
  categoryEditedAt   DateTime?
  status         PostStatus    @default(PENDING_AI)
  isPaid         Boolean       @default(false)
  isPinned       Boolean       @default(false)
  isFeatured     Boolean       @default(false)
  isSeed         Boolean       @default(false)
  // Moderator pin into "Neighborhood Highlights". Null = not pinned.
  // Pin auto-expires 14 days after this timestamp at the query layer.
  highlightPinnedAt DateTime?
  coordinationMode CoordinationMode @default(OPEN)
  activeThreadId String?       // for exclusive mode: the one active thread
  price          Float?        // for marketplace items (the effective / "new" price)
  // Offers ("عروض"): a user-marked deal. isOffer is the canonical flag
  // the Offers feed chip and the Market's Offers tab filter on — kept
  // SEPARATE from intent=OFFER (the offer-vs-request "side"), which is
  // far broader and not what users mean by a "deal". originalPrice is
  // the optional pre-offer price shown struck-through next to `price`.
  isOffer        Boolean       @default(false)
  originalPrice  Float?        // optional "was" price for an offer/deal
  imageUrls      String[]      // array of image URLs
  // PDF attachment — single optional document up to 25MB. pdfUrl points
  // at the Vercel Blob; pdfName is the original filename for display.
  // Uploaded via /api/upload-pdf (client-direct so we bypass the
  // Next.js function body cap). Rendered through the shared PdfTile
  // component in PostCard.
  pdfUrl         String?
  pdfName        String?
  locationLat    Float?        // attached map location
  locationLng    Float?
  locationName   String?       // place name for display
  author         User          @relation(fields: [authorId], references: [id])
  authorId       String
  neighborhood   Neighborhood  @relation(fields: [neighborhoodId], references: [id])
  neighborhoodId String
  expiresAt      DateTime?     // for paid ads
  reportCount    Int           @default(0)
  // Distinct-viewer count, denormalized. Incremented only on a user's
  // FIRST view (one PostView row per user); re-views don't bump it.
  viewCount      Int           @default(0)
  reports        Report[]
  reactions      Reaction[]
  bookmarks      Bookmark[]
  subscriptions  PostSubscription[]
  comments       Comment[]
  views          PostView[]
  payment        Payment?
  editedAt       DateTime?     // set when author edits
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([neighborhoodId, category, status])
  @@index([authorId])
  @@index([neighborhoodId, highlightPinnedAt])
}

// One row per (post, user) who has viewed the post — the dedup key
// for the distinct-viewer count. A re-view is a no-op (unique
// constraint), so a user is counted once no matter how many times
// they come back to the post.
model PostView {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

// A user's manual claim to a home neighborhood, made while outside its
// polygon (can't pass GPS right now). Doubles as the mod review queue AND
// the audit log of home-neighborhood changes — one row per claim attempt,
// `status` tracks the decision.
model NeighborhoodClaim {
  id             String   @id @default(cuid())
  user           User     @relation("claimant", fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  neighborhood   Neighborhood @relation("neighborhoodClaims", fields: [neighborhoodId], references: [id])
  neighborhoodId String
  status         NeighborhoodClaimStatus @default(PENDING)
  note           String?  // optional user note / proof reference
  reviewedBy     User?    @relation("claimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([status])
  @@index([neighborhoodId, status])
  @@index([userId])
}

// Neighborhood membership state.
//   VERIFIED_RESIDENT — GPS- or mod-confirmed resident; full rights.
//   CLAIMED_RESIDENT  — selected this hood as home while outside; limited
//                       rights (feed + comment + REQUEST-only posts) until
//                       verified via GPS or mod approval.
//   OUTSIDE           — no resident claim (visitor / pre-onboarding).
enum Membership {
  VERIFIED_RESIDENT
  CLAIMED_RESIDENT
  OUTSIDE
}

enum NeighborhoodClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

// Canonical category enum (renamed from PostCategoryV2 in Phase 4).
enum PostCategory {
  HOME_BUSINESSES       // الأسر المنتجة (was FOOD_HOME)
  MARKETPLACE           // سوق الحي
  SERVICES              // خدمات
  RIDES                 // مشاوير (was RIDE_REQUEST + intent=REQUEST)
  REAL_ESTATE           // عقارات
  LOST_FOUND            // مفقودات
  NEIGHBORHOOD_REPORTS  // بلاغات الحي (was NEIGHBORHOOD_ISSUE / ALERT)
  EVENTS                // فعاليات ومناسبات (was MOSQUE / EID_RAMADAN)
  COMPETITIONS          // مسابقات وجوائز (was CONTESTS)
  GENERAL               // hidden admin-only fallback
}

enum PostIntent {
  OFFER     // user is offering something
  REQUEST   // user is asking / looking for something (was LOOKING_FOR / RIDE_REQUEST)
  NORMAL    // informational / no transactional intent
}

// Who, relative to the post's neighborhood, created it.
//   RESIDENT        — author is a verified member of the target hood
//                     (the default; full posting rights).
//   OUTSIDE_REQUEST — author was NOT a member of the target hood at
//                     creation time. Restricted to intent=REQUEST only,
//                     never boosted, never pushed broadly. See the gate
//                     in /api/posts.
enum PostOriginScope {
  RESIDENT
  OUTSIDE_REQUEST
}

enum PostPriority {
  LOW
  NORMAL
  HIGH        // LOST_FOUND, NEIGHBORHOOD_REPORTS, ALERT
  CRITICAL    // emergency-class — bypasses category filters
}

enum PostAudience {
  ALL
  WOMEN       // was WOMEN_ONLY category
  MEN
}

// Marketplace listing subtype. Only meaningful when category=MARKETPLACE.
enum MarketplaceType {
  SELL  // default — selling an item / property
  BUY   // looking to buy
  JOB   // job opportunity (employer posting; not a job-seeker request)
}

// Real-estate subtype. Only meaningful when category=REAL_ESTATE.
// Inferred by the classifier from rent/sale modifiers × property type.
// WANTED is the catch-all when the user is asking ("أبحث عن / مطلوب")
// without naming a concrete buy vs rent intent.
enum RealEstateType {
  APARTMENT_RENT
  APARTMENT_SALE
  VILLA_RENT
  VILLA_SALE
  LAND_SALE
  COMMERCIAL_SHOP
  WAREHOUSE
  WANTED
}

// Civic-issue subtype. Only meaningful when category=NEIGHBORHOOD_REPORTS.
// Drives the small chip on PostCard ("مرور وسلامة" / "بنية تحتية" / etc.)
// when the classifier is confident enough. Mods can leave it null
// without losing the post.
enum CivicType {
  TRAFFIC_SAFETY
  INFRASTRUCTURE
  PUBLIC_SERVICES
  ENVIRONMENT
  PROPOSAL
  COMPLAINT
}

enum CoordinationMode {
  OPEN       // multiple threads allowed (services, marketplace)
  EXCLUSIVE  // one active thread at a time (ride requests)
}

enum PostStatus {
  PENDING_AI      // waiting for AI check
  ACTIVE          // live and visible
  IN_PROGRESS     // exclusive post claimed by a responder
  HIDDEN          // hidden by reports, pending review
  REMOVED         // removed by moderator
  EXPIRED         // paid ad expired
  ARCHIVED        // auto-archived after free duration ended
}

// ─── Reports ──────────────────────────────────────────────────────────────────

model Report {
  id           String       @id @default(cuid())
  reason       ReportReason
  details      String?
  reporter     User         @relation("reporter", fields: [reporterId], references: [id])
  reporterId   String
  post         Post         @relation(fields: [postId], references: [id])
  postId       String
  reportedUser User         @relation("reportedUser", fields: [reportedUserId], references: [id])
  reportedUserId String
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())

  @@unique([reporterId, postId])
}

enum ReportReason {
  WRONG_CATEGORY
  SPAM
  INAPPROPRIATE
  SCAM
  NOT_NEIGHBORHOOD
  OFFENSIVE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

// ─── Account-level user reports ───────────────────────────────────────────────
// Separate from Report (post-level) so existing post moderation is unaffected.
// Captures account/behavior-level complaints: impersonation, scams, harassment,
// abusive DMs, profile content, etc. A reporter may file multiple reports
// against the same user over time, but duplicates (same reporter+target+reason)
// within a short window are blocked at the API layer.
model UserReport {
  id             String             @id @default(cuid())
  reporter       User               @relation("userReporter", fields: [reporterId], references: [id])
  reporterId     String
  reportedUser   User               @relation("userReported", fields: [reportedUserId], references: [id])
  reportedUserId String
  reason         UserReportReason
  details        String?
  source         UserReportSource   @default(PROFILE)
  // Optional context — lets moderators jump to the surface where the
  // report was filed (a specific post, DM thread, or marketplace listing).
  postId         String?
  conversationId String?
  listingId      String?
  status         ReportStatus       @default(PENDING)
  // ── Moderator-aware fields ──
  // isModeratorTarget is set when the reported user was a
  // NEIGHBORHOOD_MOD at the time of the report. This lets the admin
  // dashboard surface mod-abuse reports separately from regular user
  // reports and drives the auto-review threshold. neighborhoodId is
  // snapshotted from the reporter at file-time so the aggregation
  // stays correct even if a mod later moves or is demoted.
  isModeratorTarget Boolean        @default(false)
  neighborhoodId    String?
  // ── Abuse resistance ──
  // reporterIpHash: HMAC-SHA256(ip + secret) captured at POST time.
  // Used only to detect coordinated pile-ons against the same mod —
  // never exposed, never stored alongside the raw IP. Hash is the
  // salted output so the column is safe even if leaked.
  // abuseFlags: comma-separated set of signals attached at create
  // time by lib/modReportWeighting — LOW_REP | BURST_CLUSTER |
  // REP_NEGATIVE. The weighted evaluator uses these to decide which
  // reports count fully, partially, or not at all. Non-authoritative;
  // the evaluator always re-reads the report + reporter at eval time.
  reporterIpHash String?
  abuseFlags     String?
  createdAt      DateTime           @default(now())

  @@index([reportedUserId])
  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
  @@index([reportedUserId, isModeratorTarget, status])
  @@index([neighborhoodId, isModeratorTarget, status])
  @@index([reportedUserId, reporterIpHash, createdAt])
}

enum UserReportReason {
  IMPERSONATION           // fake account / pretending to be someone else
  SCAM_FRAUD              // selling stolen goods, payment scams
  HARASSMENT              // unwanted contact, stalking, bullying
  ABUSIVE_LANGUAGE        // slurs, threats, hate speech
  SPAM                    // unsolicited advertising / mass-messaging
  INAPPROPRIATE_PROFILE   // offensive avatar, bio, cover image
  // ── Moderator-specific reasons (only valid when isModeratorTarget) ──
  MOD_ABUSE_OF_POWER      // removing content to silence, targeted bans
  MOD_UNFAIR_MODERATION   // inconsistent / biased decisions
  MOD_HARASSMENT          // mod personally harassing residents
  MOD_INACTIVE            // never responds, dead mod seat
  OTHER
}

enum UserReportSource {
  PROFILE
  POST
  CHAT
  MARKETPLACE
  PROVIDER
}

// ─── Reactions ────────────────────────────────────────────────────────────────

model Reaction {
  id        String   @id @default(cuid())
  emoji     String   // any emoji character e.g. "❤️", "😂", "👍"
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId]) // one reaction per user per post
  @@index([postId])
}

model Bookmark {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

// ─── Post Subscriptions ───────────────────────────────────────────────────────
// Interest-tracking row: any user can subscribe to any post they didn't
// author and receive new-comment notifications on it. Distinct from
// Bookmark (personal save for later) and from reactions (engagement
// signal). Unique(postId, userId) prevents duplicate rows; cascading
// delete on the post cleans up subscriptions when a post is removed.
model PostSubscription {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  // lastNotifiedAt drives anti-spam rate limiting — the comment fan-out
  // only pushes to this subscriber if the last push landed more than
  // NOTIFY_COOLDOWN_MS ago. Bell rows still land every time so the
  // in-app notification count stays accurate.
  lastNotifiedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@index([postId])
}

// ─── Comments ─────────────────────────────────────────────────────────────────

model Comment {
  id        String    @id @default(cuid())
  body      String
  imageUrl  String?
  // PDF attachment on a comment — same Vercel-Blob-backed model as
  // Post.pdfUrl / Post.pdfName. Nullable; defaults to no attachment.
  pdfUrl    String?
  pdfName   String?
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User      @relation(fields: [authorId], references: [id])
  authorId  String
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?
  replies   Comment[] @relation("CommentReplies")
  likes     CommentLike[]
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  @@index([postId])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  userId    String
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  post          Post          @relation(fields: [postId], references: [id])
  postId        String        @unique
  amount        Float
  currency      String        @default("SAR")
  status        PaymentStatus @default(PENDING)
  moyasarId     String?       // Moyasar payment ID
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ─── Compounds (B2B) ──────────────────────────────────────────────────────────

model Compound {
  id             String       @id @default(cuid())
  name           String
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id])
  neighborhoodId String
  adminPhone     String
  isActive       Boolean      @default(true)
  subscriptionEndsAt DateTime?
  announcements  Announcement[]
  maintenanceRequests MaintenanceRequest[]
  createdAt      DateTime     @default(now())
}

model Announcement {
  id         String   @id @default(cuid())
  compound   Compound @relation(fields: [compoundId], references: [id])
  compoundId String
  title      String
  body       String
  createdAt  DateTime @default(now())
}

model MaintenanceRequest {
  id          String            @id @default(cuid())
  compound    Compound          @relation(fields: [compoundId], references: [id])
  compoundId  String
  unitNumber  String
  description String
  status      MaintenanceStatus @default(OPEN)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ─── Notifications ───────────────────────────────────────────────────────────

enum NotificationType {
  COMMENT_ON_POST
  REACTION_ON_POST
  REPLY_TO_COMMENT
  LOOKING_FOR_POST
  NEW_MESSAGE
  RIDE_OFFER
  RIDE_STATUS
  RIDE_MESSAGE
  RIDE_RATING
  SYSTEM
  REPORT
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  read      Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id])
  userId    String
  actorId   String
  actorName String?
  postId    String?
  postTitle String?
  commentId String?
  threadId       String?
  rideRequestId  String?
  title          String?
  titleEn        String?
  body           String?
  bodyEn         String?
  createdAt      DateTime         @default(now())

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}

// ─── Reputation ──────────────────────────────────────────────────────────────

model ReputationLog {
  id         String   @id @default(cuid())
  userId     String   // who receives the rep change
  fromUserId String?  // who triggered it (null for system)
  action     String   // reaction_received, comment_engaged, ride_completed, report_confirmed, etc.
  points     Int      // positive or negative
  postId     String?  // context
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, fromUserId, action]) // for anti-abuse pair checks
}

// ─── Verification Requests ───────────────────────────────────────────────────

model VerificationRequest {
  id          String   @id @default(cuid())
  userId      String
  businessName String?
  description String
  proofUrl    String?  // optional document/photo
  status      String   @default("pending") // pending | approved | rejected
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, status])
  @@index([status, createdAt])
}

// ─── Neighborhood Changes ────────────────────────────────────────────────────

model NeighborhoodChangeLog {
  id                  String   @id @default(cuid())
  userId              String
  fromNeighborhoodId  String
  toNeighborhoodId    String
  reason              String   // MOVED | TEMPORARY | OTHER
  customReason        String?
  changedBy           String   @default("user") // "user" | "admin"
  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
}

model NeighborhoodChangeRequest {
  id                     String   @id @default(cuid())
  userId                 String
  currentNeighborhoodId  String
  requestedNeighborhoodId String
  reason                 String
  customReason           String?
  status                 String   @default("pending") // pending | approved | rejected
  reviewedBy             String?
  reviewedAt             DateTime?
  createdAt              DateTime @default(now())

  @@index([userId, status])
  @@index([status, createdAt])
}

// ─── Mod Role Requests ──────────────────────────────────────────────────────

model ModRequest {
  id              String   @id @default(cuid())
  userId          String
  neighborhoodId  String
  reason          String
  status          String   @default("pending") // pending | approved | rejected
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([userId, status])
  @@index([status, createdAt])
}

// ─── Moderator lifecycle status ─────────────────────────────────────────────
//
// ACTIVE        — default, full mod powers
// INACTIVE      — >30d since last mod action; still has powers but flagged
// UNDER_REVIEW  — >60d inactive OR abuse-report threshold hit; admin must decide
// SUSPENDED    — admin temporarily revoked powers (role still NEIGHBORHOOD_MOD)
enum ModStatus {
  ACTIVE
  INACTIVE
  UNDER_REVIEW
  SUSPENDED
}

// ─── Moderator Action Audit Log ─────────────────────────────────────────────
// Purpose-built audit log for NEIGHBORHOOD_MOD actions, separate from the
// pre-existing ModerationLog (which is admin-oriented and keyed by adminId
// as a string). ModActionLog is a typed relation so we can aggregate per
// moderator, check for conflict-of-interest (acting on own post / blocked
// user), and drive the mod-health dashboard cheaply.
model ModActionLog {
  id             String    @id @default(cuid())
  moderator      User      @relation("modActionLogs", fields: [moderatorId], references: [id], onDelete: Cascade)
  moderatorId    String
  actionType     String    // hide_post | remove_post | resolve_report | approve_emergency | reject_emergency | warn_user | suspend_user | ...
  targetType     String    // post | user_report | user | emergency_request | comment
  targetId       String
  neighborhoodId String?   // snapshot at action-time for scoped admin queries
  details        String?   // free-form JSON/text (reason, metadata)
  createdAt      DateTime  @default(now())

  @@index([moderatorId, createdAt])
  @@index([targetType, targetId])
  @@index([neighborhoodId, createdAt])
}

// ─── Polls / Voting ─────────────────────────────────────────────────────────

model Poll {
  id              String         @id @default(cuid())
  question        String
  options         String[]       // array of option texts
  votes           PollVote[]
  comments        PollComment[]
  reactions       PollReaction[]
  views           PollView[]
  // Distinct-viewer count — bumped once per user on first view (one PollView
  // row per user); re-views don't increment. Mirrors Post.viewCount.
  viewCount       Int            @default(0)
  authorId        String
  author          User           @relation(fields: [authorId], references: [id])
  neighborhoodId  String
  expiresAt       DateTime?      // optional deadline
  status          String         @default("active") // "active" | "closed"
  createdAt       DateTime       @default(now())

  @@index([neighborhoodId, status, createdAt])
  @@index([authorId])
}

// One row per (poll, user) who has viewed the poll — the dedup key for the
// distinct-viewer count. Mirrors PostView. userId is a plain string (no User
// relation), matching PollVote / PollReaction.
model PollView {
  id        String   @id @default(cuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
}

model PollVote {
  id          String   @id @default(cuid())
  pollId      String
  poll        Poll     @relation(fields: [pollId], references: [id])
  userId      String
  optionIndex Int      // which option (0-based)
  createdAt   DateTime @default(now())

  @@unique([pollId, userId]) // one vote per user per poll
  @@index([pollId])
}

model PollComment {
  id        String   @id @default(cuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id])
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([pollId, createdAt])
}

model PollReaction {
  id      String @id @default(cuid())
  pollId  String
  poll    Poll   @relation(fields: [pollId], references: [id])
  userId  String
  emoji   String

  @@unique([pollId, userId])
  @@index([pollId])
}

// ─── Poll Requests (resident-suggested polls, mod-reviewed) ─────────────────
// Residents can suggest a poll; a neighborhood mod must approve before a
// real Poll is created. Direct Poll creation stays admin-only. The
// approved-with-edits path stores the final (possibly edited) title +
// options back on this row so the audit trail is complete without
// touching ModerationLog. `approvedPollId` is a plain string column (no
// FK relation) so deleting a Poll later doesn't cascade-rewrite the
// request history.

enum PollRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PollRequest {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation("PollRequestSubmitter", fields: [userId], references: [id])
  neighborhoodId  String
  neighborhood    Neighborhood       @relation(fields: [neighborhoodId], references: [id])
  title           String
  description     String?
  // Match Poll.options shape exactly so approve can pass the array
  // straight through without coercion.
  options         String[]
  reason          String?
  status          PollRequestStatus  @default(PENDING)
  reviewedById    String?
  reviewedBy      User?              @relation("PollRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?
  // If the mod edits before approving, the FINAL (post-edit) title and
  // options are stored back on `title` / `options` so the audit trail
  // for what actually became a Poll lives here. The pre-edit values
  // are kept in these *Original columns. Null = mod approved without
  // editing.
  titleOriginal   String?
  optionsOriginal String[]
  // Pointer to the created Poll for audit. Plain field, no FK so a
  // future Poll delete doesn't cascade-rewrite history.
  approvedPollId  String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([neighborhoodId, status, createdAt])
  @@index([userId, createdAt])
}

// ─── Neighborhood Reports (to admin) ────────────────────────────────────────

model NeighborhoodReport {
  id              String   @id @default(cuid())
  userId          String
  neighborhoodId  String
  type            String   // "complaint" | "suggestion" | "issue" | "other"
  subject         String
  body            String
  imageUrls       String[]
  status          String   @default("open") // "open" | "reviewed" | "resolved" | "closed"
  reply           String?
  repliedBy       String?
  repliedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([neighborhoodId, status, createdAt])
  @@index([userId, createdAt])
}

// ─── Support Tickets ────────────────────────────────────────────────────────

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // "bug" | "feature" | "complaint" | "other"
  subject     String
  body        String
  imageUrls   String[] // screenshots
  status      String   @default("open") // "open" | "in_progress" | "resolved" | "closed"
  reply       String?  // admin reply
  repliedBy   String?
  repliedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// ─── Moderation Logs ─────────────────────────────────────────────────────────

model ModerationLog {
  id         String   @id @default(cuid())
  adminId    String
  adminName  String?
  action     String   // hide_post, remove_post, ban_user, unban_user, change_role, approve_nbhd, reject_nbhd
  targetType String   // post, user, request
  targetId   String
  reason     String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetId])
}

// ─── Private Threads ─────────────────────────────────────────────────────────

model Thread {
  id        String       @id @default(cuid())
  user1     User         @relation("threadUser1", fields: [user1Id], references: [id])
  user1Id   String
  user2     User         @relation("threadUser2", fields: [user2Id], references: [id])
  user2Id   String
  postId    String?      // the post that started this thread
  status    ThreadStatus @default(ACTIVE)
  closedBy  String?      // userId of who closed it
  messages  Message[]
  updatedAt DateTime     @updatedAt
  createdAt DateTime     @default(now())

  @@unique([user1Id, user2Id, postId])
  @@index([user1Id, status, updatedAt])
  @@index([user2Id, status, updatedAt])
  @@index([postId])
}

enum ThreadStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

model Message {
  id          String      @id @default(cuid())
  thread      Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId    String
  sender      User        @relation(fields: [senderId], references: [id])
  senderId    String
  type        MessageType @default(TEXT)
  text        String?
  lat         Float?
  lng         Float?
  imageUrl    String?
  // PDF attachment on a chat message — same model as Post.pdfUrl.
  // Set only when type == PDF; null on every other message type.
  pdfUrl      String?
  pdfName     String?
  // Voice note (type == VOICE). m4a/AAC on native (consistent across
  // iOS + Android via @capgo/capacitor-audio-recorder); webm only as
  // the web fallback. All null on non-VOICE messages.
  audioUrl       String?
  audioDurationMs Int?
  audioMimeType  String?
  audioSizeBytes Int?
  edited      Boolean     @default(false)
  reactions   Json        @default("[]")  // [{emoji, userId}]
  // userIds who hid this message via "Delete for me". The read query
  // filters rows where currentUserId is in this list. Independent from
  // type=DELETED (which is the "Delete for everyone" tombstone).
  hiddenBy    String[]    @default([])
  replyToId   String?
  replyTo     Message?    @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]   @relation("MessageReplies")
  deliveredAt DateTime?   // set when recipient's client fetches messages
  readAt      DateTime?   // set when recipient views the chat
  createdAt   DateTime    @default(now())

  @@index([threadId, createdAt])
  @@index([replyToId])
}

enum MessageType {
  TEXT
  LOCATION
  IMAGE
  PDF
  VOICE
  DELETED
}

// ═══════════════════════════════════════════════════════════════════════════════
// RIDES SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

enum RideStatus {
  RIDE_OPEN
  RIDE_SELECTED
  RIDE_CONFIRMED
  RIDE_EN_ROUTE
  RIDE_ARRIVED
  RIDE_IN_PROGRESS
  RIDE_PENDING_COMPLETION
  RIDE_COMPLETED
  RIDE_CANCELLED
  RIDE_EXPIRED
  RIDE_DISPUTED
}

enum OfferStatus {
  OFFER_PENDING
  OFFER_ACCEPTED
  OFFER_PASSED
  OFFER_WITHDRAWN
}

enum CompletionMode {
  REQUESTER_CONFIRMED
  AUTO_CLOSED
}

// What kind of trip this RideRequest represents:
//   RIDE     — moving a person from A to B (the original product)
//   DELIVERY — moving an item the requester needs picked up and dropped
//              off (e.g. groceries from Lulu, food from a restaurant).
// Drivers offer/price the same way for both; the type just changes
// what fields the requester fills in (item description vs passenger
// count) and where the request surfaces (DELIVERY also appears in
// the LOOKING_FOR feed as a slim cross-listing card).
enum RideRequestType {
  RIDE
  DELIVERY
}

// ─── Ride Requests ──────────────────────────────────────────────────────────

model RideRequest {
  id                 String      @id @default(cuid())

  requesterId        String
  requester          User        @relation("rideRequests", fields: [requesterId], references: [id])

  // Pickup — exact coords private, area public
  pickupLat          Float
  pickupLng          Float
  pickupAddress      String      // exact — revealed only to confirmed driver
  pickupArea         String      // district name — always public

  // Dropoff — same privacy model
  dropoffLat         Float
  dropoffLng         Float
  dropoffAddress     String
  dropoffArea        String

  // System-calculated at creation (immutable)
  distanceKm         Float
  durationMin        Int
  estimatedMinPrice  Int
  estimatedMaxPrice  Int

  // Scheduling
  isImmediate        Boolean     @default(true)
  scheduledAt        DateTime?

  notes              String?

  // RIDE vs DELIVERY. Defaults to RIDE so existing rows are unchanged.
  type               RideRequestType @default(RIDE)
  // For DELIVERY only — what the requester wants delivered. e.g.
  // "2kg apples from Lulu" or "ready order from Albaik in Khurais".
  // Optional even on DELIVERY because the requester may pre-fill it
  // through a sheet that asks for the item separately. Drivers see
  // this string verbatim on the offer screen.
  itemDescription    String?

  // State
  status             RideStatus  @default(RIDE_OPEN)
  selectedOfferId    String?     @unique

  // Deadlines
  confirmDeadline    DateTime?
  expiresAt          DateTime

  // Lifecycle timestamp
  selectedAt         DateTime?

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  neighborhoodId     String?

  // Relations
  offers             RideOffer[]
  trip               Trip?
  events             RideEvent[]
  rideMessages       RideMessage[]

  @@index([status, neighborhoodId, createdAt])
  @@index([requesterId, status])
  @@index([expiresAt])
}

// ─── Ride Offers ────────────────────────────────────────────────────────────

model RideOffer {
  id              String       @id @default(cuid())

  rideRequestId   String
  rideRequest     RideRequest  @relation(fields: [rideRequestId], references: [id])

  driverId        String
  driver          User         @relation("rideOffers", fields: [driverId], references: [id])

  price           Int
  arrivalMin      Int
  message         String?

  status          OfferStatus  @default(OFFER_PENDING)
  editCount       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([rideRequestId, driverId])
  @@index([rideRequestId, status])
  @@index([driverId])
}

// ─── Trips ──────────────────────────────────────────────────────────────────

model Trip {
  id                       String          @id @default(cuid())

  rideRequestId            String          @unique
  rideRequest              RideRequest     @relation(fields: [rideRequestId], references: [id])

  requesterId              String
  driverId                 String
  agreedPrice              Int

  // Lifecycle timestamps — each set exactly once, write-once
  confirmedAt              DateTime        @default(now())
  enRouteAt                DateTime?
  arrivedAt                DateTime?
  startedAt                DateTime?
  driverMarkedDoneAt       DateTime?
  requesterConfirmedDoneAt DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?

  completionMode           CompletionMode?

  cancelledBy              String?
  cancelReason             String?

  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  // Relations
  ratings                  RideRating[]
  dispute                  RideDispute?

  @@index([requesterId])
  @@index([driverId])
}

// ─── Ride Ratings ───────────────────────────────────────────────────────────

model RideRating {
  id          String   @id @default(cuid())

  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id])

  raterId     String   // who gave the rating
  targetId    String   // who received the rating
  role        String   // "requester_rates_driver" | "driver_rates_requester"

  score       Int      // 1-5
  comment     String?

  createdAt   DateTime @default(now())

  @@unique([tripId, raterId])
  @@index([targetId])
}

// ─── Ride Disputes ──────────────────────────────────────────────────────────

model RideDispute {
  id             String    @id @default(cuid())

  tripId         String    @unique
  trip           Trip      @relation(fields: [tripId], references: [id])

  openedBy       String
  reason         String

  status         String    @default("open") // "open" | "resolved_completed" | "resolved_cancelled"
  resolvedBy     String?
  resolution     String?
  resolvedAt     DateTime?

  createdAt      DateTime  @default(now())

  @@index([status])
}

// ─── Ride Events (Audit Log) ────────────────────────────────────────────────

model RideEvent {
  id              String      @id @default(cuid())

  rideRequestId   String
  rideRequest     RideRequest @relation(fields: [rideRequestId], references: [id])

  tripId          String?

  eventType       String      // RideEventType values as string for flexibility
  actorType       String      // "requester" | "driver" | "system" | "admin"
  actorId         String?

  metadata        Json?

  createdAt       DateTime    @default(now())

  @@index([rideRequestId, createdAt])
  @@index([tripId, createdAt])
}

// ─── Ride Messages ──────────────────────────────────────────────────────────

model RideMessage {
  id              String      @id @default(cuid())

  rideRequestId   String
  rideRequest     RideRequest @relation(fields: [rideRequestId], references: [id])

  senderId        String
  body            String
  type            String      @default("TEXT") // TEXT | LOCATION | IMAGE
  lat             Float?
  lng             Float?
  imageUrl        String?

  createdAt       DateTime    @default(now())

  @@index([rideRequestId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// PUSH NOTIFICATIONS (FCM + DB-backed queue)
// ═══════════════════════════════════════════════════════════════════════════════

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String   // ios | android | web
  deviceId   String?
  appVersion String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeenAt])
}

model NotifPreference {
  userId          String   @id
  newPostInNbhd   Boolean  @default(true)
  commentOnYours  Boolean  @default(true)
  replyOnYours    Boolean  @default(true)
  reactionOnYours Boolean  @default(true)
  directMessage   Boolean  @default(true)
  emergencyAlert  Boolean  @default(true)
  weeklyDigest    Boolean  @default(true)
  quietStartHr    Int?
  quietEndHr      Int?

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotifJob {
  id           String    @id @default(cuid())
  type         String    // new_post | comment_on_post | reply_to_comment | reaction_on_post | weekly_digest | emergency_alert | dm
  priority     String    @default("normal") // high | normal | low
  targetType   String    // user | user_list | nbhd_topic
  targetRef    String    // userId | JSON array | neighborhoodId
  payload      Json
  dedupKey     String?
  runAt        DateTime  @default(now())
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  status       String    @default("pending") // pending | running | done | failed | dropped
  lastError    String?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  @@index([status, runAt, priority])
  @@index([dedupKey, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// WEEKLY DIGEST
// ═══════════════════════════════════════════════════════════════════════════════

model DigestLog {
  userId    String
  weekStart DateTime
  sentAt    DateTime @default(now())
  postCount Int      @default(0)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, weekStart])
  @@index([weekStart])
